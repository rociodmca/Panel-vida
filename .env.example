# ---------------------------------------------------------------------------
# Panel de vida — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.
# ---------------------------------------------------------------------------

# --- Supabase (obligatorio para salir del modo demo) -----------------------
# Proyecto: https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (solo servidor, jamás NEXT_PUBLIC_). Se usa en cron y OAuth.
SUPABASE_SERVICE_ROLE_KEY=

# --- Seguridad del cron ----------------------------------------------------
# Secreto para proteger /api/cron/digest. Vercel Cron lo envía automáticamente
# como Authorization: Bearer <CRON_SECRET>. Genera uno con: openssl rand -hex 32
CRON_SECRET=

# --- URL pública de la app -------------------------------------------------
# Necesaria para los callbacks OAuth y enlaces del digest.
# En Vercel se puede usar VERCEL_PROJECT_PRODUCTION_URL, si no define la tuya.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (Calendar y Gmail) ---------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
# Scopes usados: calendar.readonly y gmail.readonly (solo lectura, sin envío).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: fija la URI de redirección si no coincide con la deducida de
# NEXT_PUBLIC_APP_URL. Debe coincidir exactamente con Google Cloud Console.
# GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/integrations/google/callback

# Opcional: scopes extra al iniciar sesión con Google mediante Supabase.
# Vacío = el login solo autentica. Con el scope de lectura de Gmail, el token
# de proveedor de la sesión también puede leer el correo:
# GOOGLE_LOGIN_EXTRA_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Cifrado de tokens OAuth en reposo (AES-256-GCM, solo servidor).
# Base64 de exactamente 32 bytes. Genera una con: openssl rand -base64 32
# Si rota la clave, los refresh tokens guardados quedan ilegibles: reconecta.
TOKEN_ENCRYPTION_KEY=

# --- Proveedor de IA (opcional) ----------------------------------------------
# Interfaz compatible con chat completions. Sin clave, el resumen de correos
# usa la plantilla determinista y la app sigue funcionando.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
# Milisegundos máximos por llamada (por defecto 20000).
AI_PROVIDER_TIMEOUT_MS=20000
# Opcional: pide JSON con response_format. Pon "false" si el proveedor lo
# rechaza (el adaptador reintenta igualmente con una petición mínima).
AI_PROVIDER_JSON_MODE=true
# Opcional: nivel de razonamiento del modelo (none, minimal, low, medium,
# high). Se usa en modelos que razonan; si el valor no es válido, el
# adaptador reintenta sin él.
AI_PROVIDER_REASONING_EFFORT=
# Opcional: modelo alternativo si el principal responde 429/5xx (sobrecarga).
AI_PROVIDER_FALLBACK_MODEL=

# Ejemplo con Google Gemini (clave en https://aistudio.google.com/apikey):
#   AI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_PROVIDER_MODEL=gemini-3.6-flash
#   AI_PROVIDER_FALLBACK_MODEL=gemini-3.5-flash-lite
#   AI_PROVIDER_REASONING_EFFORT=minimal

# --- Clima en el resumen matinal (opcional) ---------------------------------
# Open-Meteo no necesita API key. Por defecto se usan las coordenadas de Madrid.
DIGEST_WEATHER_LAT=
DIGEST_WEATHER_LON=

# --- Correo transaccional (saliente) ---------------------------------------
# Proveedor elegido: "resend" (recomendado) o "log" (modo desarrollo, no envía).
EMAIL_PROVIDER=log
EMAIL_API_KEY=
# Dominio verificado en el proveedor, p. ej. resumen@tudominio.com
EMAIL_FROM=
